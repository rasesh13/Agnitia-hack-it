{
  "name": "surya-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:simulator": "npm --prefix ../simulator ci && npm --prefix ../simulator run build -- --outDir ../frontend/public/simulator --emptyOutDir",
    "lint": "eslint . --ext ts,tsx --rule \"@typescript-eslint/no-explicit-any: off\" --rule \"react-hooks/exhaustive-deps: off\" --rule \"react-refresh/only-export-components: off\" --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.0",
    "framer-motion": "^14.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
