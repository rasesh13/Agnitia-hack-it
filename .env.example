# ==============================================================================
# SURYA (Smart Unified Renewable Yield Automation) - Environment Configuration
# ==============================================================================

# Server
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Authentication & Security
# WARNING: Change JWT_SECRET_KEY in production to a secure random 32+ character key
JWT_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
GOOGLE_CLIENT_ID=

# Database
# Use sqlite+aiosqlite:///./surya_dev.db for local development or postgresql+asyncpg://user:pass@host:5432/surya
DATABASE_URL=sqlite+aiosqlite:///./surya_dev.db

# Telemetry Configuration
TELEMETRY_POLL_INTERVAL_SECONDS=5
TELEMETRY_STALE_AFTER_SECONDS=30
TELEMETRY_FAILURE_AFTER_SECONDS=60

# Decision Scheduler
DECISION_CYCLE_SECONDS=10
SCHEDULER_ENABLED=true

# Optimization Weights & Parameters
# COST_WEIGHT + CARBON_WEIGHT must equal 1.0
COST_WEIGHT=0.6
CARBON_WEIGHT=0.4
GRID_EMISSION_FACTOR_KG_PER_KWH=0.716

# Alert Thresholds
ALERT_LOW_BATTERY_SOC=25.0
ALERT_CRITICAL_BATTERY_SOC=15.0
ALERT_HIGH_GRID_IMPORT_KW=450.0
ALERT_RESERVE_FLOOR_PERCENT=20.0
ALERT_DATA_STALENESS_SECONDS=30

# Battery Operational Constraints
BATTERY_MIN_SOC=10.0
BATTERY_MAX_SOC=95.0
BATTERY_MAX_CHARGE_RATE_KW=200.0
BATTERY_MAX_DISCHARGE_RATE_KW=200.0
BATTERY_HEALTH_FLOOR=70.0

# Grid & Site Configuration
GRID_IMPORT_TARIFF_PER_KWH=8.50
GRID_EXPORT_TARIFF_PER_KWH=3.50
CURRENCY=INR
SITE_TIMEZONE=Asia/Kolkata

# Adapter Layer Configuration
# Options: rest, modbus, mqtt (in-memory stub is test-only)
ADAPTER_TYPE=rest
ADAPTER_HOST=localhost
ADAPTER_PORT=8080
ADAPTER_POLL_TIMEOUT_SECONDS=5
CLOSED_LOOP_CONTROL_ENABLED=false

# Data Retention
TELEMETRY_RETENTION_DAYS=90
DECISION_AUDIT_RETENTION_DAYS=365
